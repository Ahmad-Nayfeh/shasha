<?xml version="1.0" encoding="utf-8"?>
<!-- IBM Plex Sans Arabic (SIL OFL 1.1, see branding/fonts/OFL.txt). The app: attributes are what AndroidX reads
     below Android 8 (Fire OS 6), where the platform ignores the android: ones. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:font="@font/plex_arabic_regular" android:fontStyle="normal" android:fontWeight="400"
        app:font="@font/plex_arabic_regular" app:fontStyle="normal" app:fontWeight="400" />
    <font android:font="@font/plex_arabic_medium" android:fontStyle="normal" android:fontWeight="500"
        app:font="@font/plex_arabic_medium" app:fontStyle="normal" app:fontWeight="500" />
    <font android:font="@font/plex_arabic_semibold" android:fontStyle="normal" android:fontWeight="600"
        app:font="@font/plex_arabic_semibold" app:fontStyle="normal" app:fontWeight="600" />
    <font android:font="@font/plex_arabic_bold" android:fontStyle="normal" android:fontWeight="700"
        app:font="@font/plex_arabic_bold" app:fontStyle="normal" app:fontWeight="700" />
</font-family>
